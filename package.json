{
  "name": "@maxmilton/adblock-rules",
  "version": "0.0.0",
  "private": true,
  "repository": "github:maxmilton/adblock-rules",
  "license": "MIT",
  "author": "Max Milton <max@2okki.com>",
  "type": "module",
  "scripts": {
    "lint": "bun lint:adblock && bun lint:fmt && bun lint:js && bun lint:ts",
    "lint:adblock": "aglint",
    "lint:fmt": "biome check",
    "lint:js": "oxlint",
    "lint:ts": "tsc --noEmit",
    "test": "bun test --only-failures",
    "test:ci": "bun test --coverage --randomize --rerun-each=3",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@adguard/aglint": "3.0.3",
    "@biomejs/biome": "2.5.15",
    "@maxmilton/oxlint-config": "0.0.24",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.3",
    "adblock-rs": "0.13.3",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "adblock-rs"
  ]
}
