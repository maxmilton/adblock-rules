{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@maxmilton/oxlint-config/recommended.json"],
  "options": {
    "maxWarnings": 50,
    "reportUnusedDisableDirectives": "error",
    "respectEslintDisableDirectives": false,
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "warn",
    "perf": "error",
    "style": "warn",
    "restriction": "error",
    "nursery": "warn"
  },
  // https://github.com/oxc-project/javascript-globals/blob/main/src/lib.rs
  "env": {
    "builtin": true,
    "es2026": true, // TODO: es2027 once in oxc.
    "bun": true,
    "commonjs": false,
    "browser": true
  },
  "rules": {
    "typescript/no-non-null-assertion": "off",
    "typescript/strict-boolean-expressions": "off",

    // TODO: Remove when we can fix all the issues
    "typescript/no-unsafe-type-assertion": "off"
  },
  "overrides": [
    {
      "files": ["lists/scriptlets/*.js"],
      "env": {
        "es2026": false,
        "bun": false
      },
      "rules": {
        "eslint/func-names": "off",
        "eslint/no-empty-function": ["error", { "allow": ["functions"] }],
        "import/unambiguous": "off",
        "typescript/no-unsafe-member-access": "off",
        "unicorn/prefer-module": "off"
      }
    },
    {
      "files": ["test/framework/build.ts", "test/framework/http.ts"],
      "plugins": ["vitest"],
      "rules": {
        "eslint/no-console": "off",
        "node/no-top-level-await": "off",
        "vitest/require-hook": "off"
      }
    }
  ]
}
